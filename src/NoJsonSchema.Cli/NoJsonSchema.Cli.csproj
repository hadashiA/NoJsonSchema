<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>nojsonschema</ToolCommandName>
    <IsPackable>true</IsPackable>
    <RootNamespace>NoJsonSchema.Cli</RootNamespace>
    <AssemblyName>nojsonschema</AssemblyName>
    <Description>CLI for the NoJsonSchema code generator.</Description>
    <PackageTags>json;schema;codegen;dotnet-tool</PackageTags>

    <!-- ConsoleAppFramework's source generator reads XML doc comments for help / short aliases. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NoJsonSchema.Core\NoJsonSchema.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>

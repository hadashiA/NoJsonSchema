<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- Build targets net8.0 but allow running on the newest installed shared runtime. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <!-- Package identity (override AssemblyName / PackageId per-csproj where needed). -->
  <PropertyGroup>
    <Authors>hadashiA</Authors>
    <Company>hadashiA</Company>
    <Product>NoJsonSchema</Product>
    <Copyright>Copyright (c) hadashiA</Copyright>
    <RepositoryUrl>https://github.com/hadashiA/NoJsonSchema</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/hadashiA/NoJsonSchema</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Single source of truth for release version; CI overrides via `dotnet pack -p:Version=…`. -->
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

  <!-- Pack / SourceLink defaults that apply to every IsPackable=true project. -->
  <PropertyGroup>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>

    <!-- Symbol packages (.snupkg) so debuggers can step into the BCL-friendly hot paths. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- SourceLink wiring — see Microsoft.SourceLink.GitHub PackageReference below. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>

    <!-- Deterministic compilation when running in GitHub Actions (avoids paths leaking into PDBs). -->
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
  </PropertyGroup>

  <!-- README from the repo root is packed into every package. The per-csproj `Pack=true` flag is
       enough; `PackagePath="\"` puts it at the package root where NuGet picks it up. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true' And Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- SourceLink: maps PDB lines to GitHub blob URLs. Only kicks in when IsPackable=true so
       library / generator builds get it; tests / samples skip the (small) extra cost. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
